{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/openagentui/*": [
        "../../packages/ui/src/components/react/openagentui/*.base",
        "../../packages/ui/src/components/react/openagentui/*"
      ],
      "@/components/icons/*": [
        "../../packages/ui/src/components/react/icons/*"
      ],
      "@/components/ui/*": [
        "../../packages/ui/src/components/react/ui/base/*",
        "../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/components/ui/radix/*": [
        "../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@/lib/utils": ["../../packages/ui/src/lib/utils"],
      "@openagentui/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
