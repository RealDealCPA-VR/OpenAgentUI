{
  "name": "@openagentui/react-native",
  "version": "0.1.46",
  "description": "React Native bindings for openagentui",
  "keywords": [
    "assistant",
    "ai",
    "chat",
    "react-native",
    "mobile"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openagentui/core": "^0.3.24",
    "@openagentui/store": "^0.3.17",
    "@openagentui/tap": "^0.9.21",
    "openagentui-cloud": "workspace:^",
    "openagentui-stream": "^0.3.48"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": "^18 || ^19",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagentui/x-buildutils": "workspace:*",
    "@openagentui/x-react18": "workspace:*",
    "@babel/core": "^7.29.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-web": "^0.21.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  }
}
