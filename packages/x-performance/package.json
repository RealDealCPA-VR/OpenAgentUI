{
  "name": "@openagentui/x-performance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "aui-perf": "./bin/aui-perf.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run",
    "perf:record": "node ./bin/aui-perf.mjs record",
    "perf:compare": "node ./bin/aui-perf.mjs compare",
    "size": "node ./bin/aui-perf.mjs size"
  },
  "devDependencies": {
    "@openagentui/ai-sdk": "workspace:*",
    "@openagentui/core": "workspace:*",
    "@openagentui/react": "workspace:*",
    "@openagentui/react-langgraph": "workspace:*",
    "@openagentui/react-markdown": "workspace:*",
    "@openagentui/react-pi": "workspace:*",
    "@openagentui/react-streamdown": "workspace:*",
    "@openagentui/store": "workspace:*",
    "@openagentui/tap": "workspace:*",
    "@openagentui/x-buildutils": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openagentui-stream": "workspace:*",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "^1.2.12",
    "vitest": "^5.0.3"
  }
}
