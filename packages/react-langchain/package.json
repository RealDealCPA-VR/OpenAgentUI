{
  "name": "@openagentui/react-langchain",
  "version": "0.0.35",
  "description": "LangChain useStream adapter for openagentui",
  "keywords": [
    "langchain",
    "langgraph",
    "openagentui",
    "react",
    "ai",
    "chat",
    "agents"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./converter": {
      "types": "./dist/converter.d.ts",
      "default": "./dist/converter.js"
    }
  },
  "typesVersions": {
    "*": {
      "converter": [
        "./dist/converter.d.ts"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openagentui/core": "^0.3.24",
    "@openagentui/store": "^0.3.17",
    "openagentui-cloud": "*",
    "openagentui-stream": "^0.3.48"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph-sdk": "^1.9.20",
    "@langchain/react": "^1.0.20",
    "@types/react": "*",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph-sdk": {
      "optional": true
    },
    "@langchain/react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagentui/x-buildutils": "workspace:*",
    "@openagentui/x-react18": "workspace:*",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph-sdk": "^1.12.0",
    "@langchain/react": "^1.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/react-langchain"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  }
}
