{
  "name": "openagentui-cloud",
  "version": "0.2.5",
  "description": "Cloud integration for openagentui",
  "keywords": [
    "assistant",
    "cloud",
    "ai",
    "chat",
    "openagentui"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "pnpm run test:v7 && pnpm run test:peer-v6 && pnpm run test:types:peer-v6",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary && pnpm run test:peer-v6 && pnpm run test:types:peer-v6",
    "typecheck": "tsc --noEmit",
    "test:v7": "vitest run",
    "test:peer-v6": "vitest run --config vitest.peer-v6.config.ts",
    "test:types:peer-v6": "tsc --noEmit --project tsconfig.peer-v6.json",
    "test:watch": "vitest"
  },
  "dependencies": {
    "openagentui-stream": "^0.3.47"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "ai": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagentui/x-buildutils": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^26.6.3",
    "ai": "^7.0.123",
    "ai-v6": "npm:ai@^6.0.277",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/cloud"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  }
}
