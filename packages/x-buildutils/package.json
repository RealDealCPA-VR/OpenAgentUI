{
  "name": "@openagentui/x-buildutils",
  "private": false,
  "version": "0.0.30",
  "description": "Internal build utilities for openagentui packages",
  "keywords": [
    "build",
    "typescript",
    "internal",
    "openagentui"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "ts",
    "types",
    "README.md"
  ],
  "bin": {
    "aui-build": "./bin/aui-build.js"
  },
  "sideEffects": false,
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@tsconfig/strictest": "^2.0.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "jiti": "^2.7.0",
    "rolldown": "^1.2.12",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.3"
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/x-buildutils"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "pnpm run test",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
