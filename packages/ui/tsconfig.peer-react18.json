{
  "extends": ["./tsconfig.json", "@openagentui/x-react18/tsconfig.json"],
  "compilerOptions": {
    "paths": {
      "react": [
        "./node_modules/@openagentui/x-react18/node_modules/@types/react-v18"
      ],
      "react/*": [
        "./node_modules/@openagentui/x-react18/node_modules/@types/react-v18/*"
      ],
      "react-dom": [
        "./node_modules/@openagentui/x-react18/node_modules/@types/react-dom-v18"
      ],
      "react-dom/*": [
        "./node_modules/@openagentui/x-react18/node_modules/@types/react-dom-v18/*"
      ],
      "@openagentui/ui/*": ["./src/*"],
      "@/components/openagentui/*": ["./src/components/react/openagentui/*"],
      "@/components/icons/*": ["./src/components/react/icons/*"],
      "@/components/ui/*": [
        "./src/components/react/ui/base/*",
        "./src/components/react/ui/radix/*"
      ],
      "@/components/ui/radix/*": ["./src/components/react/ui/radix/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
