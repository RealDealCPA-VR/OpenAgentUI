{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "../x-buildutils/types"
    ],
    "types": ["browser-process"],
    "paths": {
      "@openagentui/ui/*": ["./src/*"],
      "@/components/openagentui/*": ["./src/components/react/openagentui/*"],
      "@/components/icons/*": ["./src/components/react/icons/*"],
      "@/components/ui/*": [
        "./src/components/react/ui/base/*",
        "./src/components/react/ui/radix/*"
      ],
      "@/components/ui/radix/*": ["./src/components/react/ui/radix/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "src/components/react-native",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ]
}
