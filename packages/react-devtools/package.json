{
  "name": "@openagentui/react-devtools",
  "version": "1.2.23",
  "description": "React development tools for openagentui components",
  "keywords": [
    "openagentui",
    "devtools",
    "react",
    "development",
    "debugging"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build:css": "node scripts/build-styles.mjs",
    "build": "pnpm build:css && aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@openagentui/react": "^0.15.0",
    "@openagentui/tap": "workspace:^",
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagentui/react": "workspace:*",
    "@openagentui/tap": "workspace:*",
    "@openagentui/x-buildutils": "workspace:*",
    "@openagentui/x-performance": "workspace:*",
    "@openagentui/x-react18": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/react-devtools"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  }
}
