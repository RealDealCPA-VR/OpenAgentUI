{
  "name": "@openagentui/react-lexical",
  "version": "0.2.16",
  "description": "Lexical-based rich text composer for openagentui with @-mention support",
  "keywords": [
    "lexical",
    "rich-text",
    "mention",
    "openagentui",
    "react",
    "ai",
    "chat"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@openagentui/react": "^0.15.0",
    "@openagentui/core": "workspace:^",
    "@openagentui/store": "workspace:^",
    "@lexical/history": ">=0.51.0",
    "@lexical/plain-text": ">=0.51.0",
    "@lexical/react": ">=0.51.0",
    "@lexical/utils": ">=0.51.0",
    "@types/react": "*",
    "lexical": ">=0.51.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagentui/core": "workspace:*",
    "@openagentui/react": "workspace:*",
    "@openagentui/store": "workspace:*",
    "@openagentui/x-buildutils": "workspace:*",
    "@openagentui/x-performance": "workspace:*",
    "@openagentui/x-react18": "workspace:*",
    "@lexical/history": "^0.52.0",
    "@lexical/plain-text": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@types/react": "^19.3.0",
    "jsdom": "^30.0.1",
    "lexical": "^0.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/react-lexical"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  }
}
