{
  "name": "@openagentui/react-ink-markdown",
  "version": "0.0.47",
  "description": "Terminal markdown rendering for @openagentui/react-ink",
  "keywords": [
    "markdown",
    "terminal",
    "ink",
    "openagentui",
    "react",
    "ai",
    "chat",
    "cli"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openagentui/core": "^0.3.24",
    "@openagentui/store": "^0.3.17",
    "markdansi": "^0.3.4"
  },
  "peerDependencies": {
    "@openagentui/react-ink": "^0.0.48",
    "@types/react": "*",
    "ink": ">=6",
    "react": "^19",
    "shiki": ">=4"
  },
  "peerDependenciesMeta": {
    "@openagentui/react-ink": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagentui/core": "workspace:*",
    "@openagentui/react-ink": "workspace:*",
    "@openagentui/store": "workspace:*",
    "@openagentui/x-buildutils": "workspace:*",
    "@openagentui/x-performance": "workspace:*",
    "@types/react": "^19.3.0",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.0",
    "shiki": "^4.4.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/react-ink-markdown"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  }
}
