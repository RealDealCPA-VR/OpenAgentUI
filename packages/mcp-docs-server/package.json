{
  "name": "@openagentui/mcp-docs-server",
  "version": "0.3.3",
  "description": "Stdio proxy for the hosted openagentui documentation MCP server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openagentui",
    "documentation",
    "ai",
    "claude"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openagentui-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "dev": "tsx src/stdio.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/server": "^2.2.0"
  },
  "devDependencies": {
    "@openagentui/x-buildutils": "workspace:*",
    "@modelcontextprotocol/core": "^2.2.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/mcp-docs-server"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  }
}
