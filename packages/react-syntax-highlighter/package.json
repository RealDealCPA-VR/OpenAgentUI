{
  "name": "@openagentui/react-syntax-highlighter",
  "version": "0.14.7",
  "description": "Syntax highlighting for openagentui",
  "keywords": [
    "syntax-highlighter",
    "code",
    "highlighting",
    "openagentui",
    "react",
    "ai",
    "chat"
  ],
  "author": "OpenAgentUI contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "default": "./dist/full.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "full",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@openagentui/react": "^0.15.0",
    "@openagentui/react-markdown": "^0.14.8",
    "@types/react": "*",
    "@types/react-syntax-highlighter": "*",
    "react": "^18 || ^19",
    "react-syntax-highlighter": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-syntax-highlighter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagentui/react": "workspace:*",
    "@openagentui/react-markdown": "workspace:*",
    "@openagentui/x-buildutils": "workspace:*",
    "@openagentui/x-react18": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://openagentui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealDealCPA-VR/OpenAgentUI.git",
    "directory": "packages/react-syntax-highlighter"
  },
  "bugs": {
    "url": "https://github.com/RealDealCPA-VR/OpenAgentUI/issues"
  }
}
