{
  "extends": "@openagentui/x-buildutils/ts/next",
  "compilerOptions": {
    "paths": {
      "@/components/ui/*": [
        "../../packages/ui/src/components/react/ui/base/*",
        "../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/components/ui/radix/*": [
        "../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/lib/utils": ["../../packages/ui/src/lib/utils"],
      "@/components/openagentui/elements/markdown-text": [
        "./components/openagentui/elements/markdown-text"
      ],
      "@/hooks/use-mobile": ["../../packages/ui/src/hooks/use-mobile"],
      "@/hooks/use-copy-to-clipboard": [
        "../../packages/ui/src/hooks/use-copy-to-clipboard"
      ],
      "@/hooks/use-attachment-src": [
        "../../packages/ui/src/hooks/use-attachment-src"
      ],
      "@/components/openagentui/*": [
        "../../packages/ui/src/components/react/openagentui/*"
      ],
      "@/components/demo/elements/*": ["./components/demo/elements/*"],
      "@/components/icons/*": [
        "./components/icons/*",
        "../../packages/ui/src/components/react/icons/*"
      ],
      "@/*": ["./*"],
      "@openagentui/ui/*": ["../../packages/ui/src/*"],
      "fumadocs-mdx:collections/*": ["./.source/*"],
      "@openagentui/react-generative-ui/*": [
        "../../packages/react-generative-ui/src/*"
      ],
      "@openagentui/store/client": ["../../packages/store/src/client"],
      "@openagentui/store/internal": ["../../packages/store/src/internal"],
      "@openagentui/*": ["../../packages/*/src"],
      "@openagentui/core/*": ["../../packages/core/src/*"],
      "@openagentui/react/*": ["../../packages/react/src/*"],
      "@openagentui/tap/*": ["../../packages/tap/src/*"],
      "openagentui-stream": ["../../packages/openagentui-stream/src"],
      "openagentui-stream/*": ["../../packages/openagentui-stream/src/*"],
      "openagentui-cloud": ["../../packages/cloud/src"],
      "openagentui-cloud/*": ["../../packages/cloud/src/*"],
      "@openagentui/safe-content-frame": [
        "../../packages/safe-content-frame/src"
      ],
      "@openagentui/safe-content-frame/*": [
        "../../packages/safe-content-frame/src/*"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
