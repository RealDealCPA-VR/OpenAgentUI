{
  "extends": "@openagentui/x-buildutils/ts/base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["react", "react-dom", "browser-process", "aui-build"],
    "paths": {
      "@/components/ui/*": ["../../packages/ui/src/components/react/ui/base/*"],
      "@/components/openagentui/*": [
        "../../packages/ui/src/components/react/openagentui/*"
      ],
      "@/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@/lib/utils": ["../../packages/ui/src/lib/utils"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@openagentui/x-buildutils/types",
      "../../node_modules/@types"
    ]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
