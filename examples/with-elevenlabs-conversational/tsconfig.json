{
  "extends": "@openagentui/x-buildutils/ts/base",
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "strictNullChecks": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./*"],
      "@/components/openagentui/*": [
        "../../packages/ui/src/components/react/openagentui/*"
      ],
      "@/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@/components/ui/*": [
        "../../packages/ui/src/components/react/ui/base/*",
        "../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/components/ui/radix/*": [
        "../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/lib/utils": ["../../packages/ui/src/lib/utils"],
      "@openagentui/ui/*": ["../../packages/ui/src/*"],
      "@openagentui/store/client": ["../../packages/store/src/client"],
      "@openagentui/store/internal": ["../../packages/store/src/internal"],
      "@openagentui/*": ["../../packages/*/src"],
      "@openagentui/core/*": ["../../packages/core/src/*"],
      "@openagentui/react/*": ["../../packages/react/src/*"],
      "@openagentui/tap/*": ["../../packages/tap/src/*"],
      "openagentui-stream": ["../../packages/openagentui-stream/src"],
      "openagentui-stream/*": ["../../packages/openagentui-stream/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
