{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash ../../scripts/vercel-ignore-changeset-release.sh",
  "installCommand": "pnpm install --frozen-lockfile --filter=@openagentui/monorepo --filter=with-react-ink-web... --filter=@openagentui/react-devtools...",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@openagentui/react-ink --filter=@openagentui/react-ink-markdown --filter=@openagentui/ai-sdk && cd examples/with-react-ink-web && pnpm run build",
  "outputDirectory": "out",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.openagentui.dev https://*.vercel.app http://localhost:*;"
        }
      ]
    }
  ]
}
