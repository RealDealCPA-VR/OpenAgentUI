{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash ../../scripts/vercel-ignore-changeset-release.sh",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@openagentui/react-native --filter=@openagentui/ai-sdk --filter=@openagentui/metro && cd examples/with-expo && pnpm run export:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/showcase",
      "destination": "/showcase/index.html"
    },
    {
      "source": "/showcase/:slug",
      "destination": "/showcase/:slug.html"
    }
  ],
  "framework": null
}
